{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/hooks/preflight-main-guard.sh\"",
              "timeout": 10,
              "statusMessage": "PRE-FLIGHT main 守卫检查中"
            }
          ]
        }
      ]
    }
  }
}
