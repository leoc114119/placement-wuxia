{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "types": []
  },
  "include": ["game.ts", "types.ts", "env.d.ts", "tests/**/*.ts", "config/**/*.ts", "systems/**/*.ts", "ui/**/*.ts", "net/**/*.ts", "proto/battle_demo/**/*.ts"]
}
